{
    "name": "nethack",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "node scripts/start-runtime.mjs",
        "build": "cross-env NODE_OPTIONS=--no-deprecation nuxt build",
        "prebuild": "node scripts/prebuild.mjs",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation nuxt dev",
        "predev": "node scripts/prebuild.mjs",
        "test": "vitest run --pool=forks --reporter=default --reporter=json --outputFile=.tmp-vitest/test-results.json && bun run test:meta .tmp-vitest/test-results.json",
        "test:postgres": "vitest run tests/server/database/postgres.integration.test.ts --pool=forks",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage --config vitest.coverage.config.ts && vitest run --coverage --config vitest.server-coverage.config.ts && node tests/helpers/merge-vitest-coverage.mjs .tmp-vitest/full-source-coverage/coverage-final.json .tmp-vitest/server-mode-coverage/coverage-final.json",
        "test:e2e": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test",
        "test:e2e:oidc": "node --test e2e/oidc-provider.test.mjs",
        "demo:capture": "node --env-file-if-exists=.env scripts/capture-board-demo.mjs",
        "demo:render": "node --env-file-if-exists=.env scripts/render-board-demo.mjs",
        "test:meta": "bun scripts/update-test-meta.ts",
        "generate": "nuxt generate",
        "pregenerate": "node scripts/generate-icon-server-bundle.mjs",
        "preview": "cross-env NODE_OPTIONS=--no-deprecation nuxt preview -p 24598",
        "postinstall": "node scripts/postinstall.mjs",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "format:js": "oxfmt \"**/*.{js,jsx,ts,tsx}\"",
        "format:html": "oxfmt \"**/*.html\"",
        "format:css": "oxfmt \"**/*.css\"",
        "format:json": "oxfmt \"**/*.json\"",
        "db:generate": "drizzle-kit generate",
        "db:backup": "node scripts/backup-postgres.mjs",
        "db:export-hackathon": "bun scripts/export-hackathon.ts",
        "db:migrate": "bun scripts/db-migrate.ts",
        "release:package": "bun scripts/package-vps-release.mjs",
        "db:import-sqlite": "bun scripts/import-sqlite-to-postgres.mjs",
        "db:import-sqlite:check": "bun scripts/import-sqlite-to-postgres.mjs --check-only",
        "db:audit-sqlite": "bun scripts/audit-sqlite-postgres.mjs",
        "benchmark:start": "node scripts/benchmark-startup.mjs",
        "benchmark:vps": "node scripts/benchmark-vps.mjs",
        "db:studio": "drizzle-kit studio",
        "lint": "eslint app server shared tests e2e scripts",
        "typecheck": "nuxt typecheck"
    },
    "dependencies": {
        "@comark/vue": "^0.9.2",
        "@iconify/utils": "^3.1.7",
        "@nuxt/eslint": "^1.17.0",
        "@nuxt/fonts": "^1.2.0",
        "@nuxt/icon": "^2.6.2",
        "@nuxt/ui": "^4.12.0",
        "@vue/shared": "^3.5.45",
        "@vueuse/core": "^15.0.0",
        "@vueuse/shared": "^15.0.0",
        "better-sqlite3": "^13.2.0",
        "busboy": "^1.6.0",
        "canvas-confetti": "^1.9.4",
        "drizzle-orm": "^0.45.4",
        "eslint": "^10.15.0",
        "gsap": "^3.15.1",
        "https-proxy-agent": "^9.1.0",
        "jdenticon": "^3.3.0",
        "jose": "^6.2.17",
        "node-fetch": "^3.3.2",
        "node-html-markdown": "^2.0.0",
        "nuxt": "^4.6.4",
        "openai": "^7.57.0",
        "openid-client": "^6.9.0",
        "postgres": "^4.1.1",
        "typescript": "6.0.3",
        "vue": "^3.5.45",
        "vue-router": "^5.5.1",
        "yaml": "2.9.1",
        "zod": "^4.6.7"
    },
    "overrides": {
        "entities": "^7.0.1",
        "estree-walker": "2.0.2",
        "unicorn-magic": "0.4.0",
        "vite": "^8.3.5",
        "deepmerge": "file:vendor/deepmerge-safe",
        "@vue/server-renderer": "3.5.45",
        "brace-expansion": "5.0.12",
        "esbuild": "0.28.2",
        "glob": "14.0.2",
        "js-yaml": "5.4.1",
        "minimatch": "11.0.1",
        "eslint-plugin-import-x": "4.18.1",
        "nanoid": "3.3.20",
        "node-forge": "1.4.3",
        "postcss-selector-parser": "7.1.6",
        "prosemirror-view": "1.42.9",
        "serialize-javascript": "7.1.3",
        "shell-quote": "1.11.0",
        "source-map-js": "1.2.2"
    },
    "devDependencies": {
        "@axe-core/playwright": "4.14.0",
        "@iconify-json/fluent": "^1.2.62",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/lucide": "^1.2.155",
        "@iconify-json/material-symbols": "^1.2.100",
        "@iconify-json/simple-icons": "^1.2.102",
        "@playwright/test": "1.65.1",
        "@types/better-sqlite3": "^9.6.0",
        "@types/bun": "1.4.4",
        "@types/busboy": "^1.5.5",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.11",
        "oxfmt": "^0.78.0",
        "vitest": "^5.1.0",
        "vue-tsc": "^3.3.14"
    },
    "patchedDependencies": {
        "@rollup/plugin-node-resolve@16.0.3": "patches/@rollup%2Fplugin-node-resolve@16.0.3.patch"
    }
}
