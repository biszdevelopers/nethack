{
    "name": "basishacks",
    "type": "module",
    "private": true,
    "scripts": {
        "start": "bun start-fix.mjs",
        "build": "cross-env NODE_OPTIONS=--no-deprecation nuxt build",
        "prebuild": "node scripts/sync-icon-collections.mjs",
        "refractor-artifact": "bash scripts/rewrite-build-paths.sh .output",
        "dev": "cross-env NODE_OPTIONS=--no-deprecation nuxt dev",
        "predev": "node scripts/sync-icon-collections.mjs",
        "test": "vitest run --pool=forks --reporter=json | bun run test:meta",
        "test:postgres": "vitest run tests/server/database/postgres.integration.test.ts --pool=forks",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage",
        "test:meta": "bun scripts/update-test-meta.ts",
        "generate": "nuxt generate",
        "pregenerate": "node scripts/sync-icon-collections.mjs",
        "preview": "cross-env NODE_OPTIONS=--no-deprecation nuxt preview -p 24598",
        "postinstall": "nuxt prepare",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "format:js": "oxfmt \"**/*.{js,jsx,ts,tsx}\"",
        "format:html": "oxfmt \"**/*.html\"",
        "format:css": "oxfmt \"**/*.css\"",
        "format:json": "oxfmt \"**/*.json\"",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun scripts/db-migrate.ts",
        "release:package": "bun scripts/package-vps-release.mjs",
        "db:import-sqlite": "bun scripts/import-sqlite-to-postgres.mjs",
        "db:import-sqlite:check": "bun scripts/import-sqlite-to-postgres.mjs --check-only",
        "benchmark:start": "node scripts/benchmark-startup.mjs",
        "benchmark:vps": "node scripts/benchmark-vps.mjs",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@comark/nuxt": "^0.5.1",
        "@iconify/utils": "^3.1.7",
        "@nuxt/eslint": "^1.17.0",
        "@nuxt/fonts": "^0.14.0",
        "@nuxt/ui": "^4.12.0",
        "@vue/shared": "^3.5.45",
        "@vueuse/core": "^14.4.0",
        "@vueuse/shared": "^14.4.0",
        "better-sqlite3": "^13.0.3",
        "busboy": "^1.6.0",
        "canvas-confetti": "^1.9.4",
        "comark": "^0.5.1",
        "drizzle-orm": "^0.45.4",
        "eslint": "^9.39.5",
        "gsap": "^3.15.1",
        "https-proxy-agent": "^9.1.0",
        "jdenticon": "^3.3.0",
        "jose": "^6.2.17",
        "node-fetch": "^3.3.2",
        "node-html-markdown": "^2.0.0",
        "nuxt": "^4.6.4",
        "openai": "^7.55.0",
        "openid-client": "^6.8.9",
        "postgres": "^4.1.0",
        "typescript": "^6.0.3",
        "vue": "^3.5.45",
        "vue-router": "^5.4.0",
        "zod": "^4.6.7"
    },
    "overrides": {
        "entities": "^7.0.1",
        "estree-walker": "2.0.2",
        "unicorn-magic": "0.4.0",
        "vite": "^8.3.5",
        "deepmerge": "file:vendor/deepmerge-safe",
        "@vue/server-renderer": "3.5.45",
        "brace-expansion": "5.0.12",
        "esbuild": "0.28.2",
        "glob": "14.0.2",
        "js-yaml": "5.4.1",
        "minimatch": "11.0.1",
        "nanoid": "3.3.20",
        "node-forge": "1.4.3",
        "postcss-selector-parser": "7.1.6",
        "prosemirror-view": "1.42.9",
        "serialize-javascript": "7.1.3",
        "shell-quote": "1.11.0",
        "source-map-js": "1.2.2"
    },
    "devDependencies": {
        "@iconify-json/fluent": "^1.2.61",
        "@iconify-json/heroicons": "^1.2.3",
        "@iconify-json/lucide": "^1.2.153",
        "@iconify-json/material-symbols": "^1.2.98",
        "@iconify-json/simple-icons": "^1.2.102",
        "@types/better-sqlite3": "^7.6.13",
        "@types/bun": "1.3.14",
        "@types/busboy": "^1.5.5",
        "@types/canvas-confetti": "^1.9.0",
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^4.1.12",
        "cross-env": "^10.1.0",
        "drizzle-kit": "^0.31.11",
        "oxfmt": "^0.78.0",
        "vitest": "^4.1.12"
    },
    "patchedDependencies": {
        "@rollup/plugin-node-resolve@16.0.3": "patches/@rollup%2Fplugin-node-resolve@16.0.3.patch"
    }
}
