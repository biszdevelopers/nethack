# REQUIRED - basis-auth cookie encryption key, must be at least 32 bytes
# Generate with: openssl rand -base64 32 or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BASIS_AUTH_COOKIE_SECRET=random_string_at_least_32_bytes_long

# REQUIRED - PostgreSQL connection used by development, CI, and production
# Keep credentials in a protected environment file; do not commit real values.
DATABASE_URL=postgresql://basishacks:replace_me@127.0.0.1:5432/basishacks

# OPTIONAL - Bounded PostgreSQL pool size (default 10; accepted range 2-64)
DATABASE_POOL_MAX=10

# OPTIONAL - Emit bounded PostgreSQL query and pool wait timing summaries once per minute
# DATABASE_METRICS=1

# OPTIONAL - One-time SQLite migration source path; used only by the import command
# SQLITE_IMPORT_PATH=/secure/backups/basishacks.sqlite

# REQUIRED - basis-auth OpenID Connect configuration
BASIS_AUTH_ISSUER=http://localhost:3000
BASIS_AUTH_CLIENT_ID=your_basis_auth_client_id_here
BASIS_AUTH_CLIENT_SECRET=your_basis_auth_client_secret_here
BASIS_AUTH_RESOURCE=devconnect://nethack.bisz.dev


# OPTIONAL - Microsoft Entra ID tenant ID (directory ID)
# Get this from Azure Portal > App Registrations > basishacks app > Overview
# Required together with MICROSOFT_CLIENT_ID for MS Graph features
MICROSOFT_TENANT_ID=your_microsoft_tenant_id_here

# OPTIONAL - Microsoft Entra ID application (client) ID
# Get this from Azure Portal > App Registrations > basishacks app > Overview
# Required together with MICROSOFT_TENANT_ID for Graph features
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here

# OPTIONAL - Microsoft Entra ID client secret for MS Graph API integration
# Enables Graph features such as meeting scheduling and Teams chat
# Get this from Azure Portal > App Registrations > basishacks app > Certificates & secrets
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here

# Optional Graph webhook configuration. Keep the state stable across restarts.
# On first startup, the subscription ID is logged after creation; persist it here
# so later startups refresh the existing subscription instead of creating another.
# MICROSOFT_WEBHOOK_STATE=replace_with_a_random_secret_at_least_32_bytes_long
# MICROSOFT_WEBHOOK_ID=subscription_id_from_the_initial_startup_log

# REQUIRED in production; used to derive the callback URL and enforce same-origin mutations
# `${CURRENT_URL_ORIGIN}/api/auth/basis/callback` must be registered in basis-auth.
# Use the public HTTPS origin only, with no trailing path (e.g., https://basishacks.com).
CURRENT_URL_ORIGIN=http://localhost:3000

# OPTIONAL - DeepSeek API key for AI chat features (debug routes only)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OPTIONAL - Server port/host override (defaults: port=3000, host=0.0.0.0)
# PORT=3000
# HOST=0.0.0.0

# OPTIONAL - ROPC test user credentials (rarely used, for testing only)
# MICROSOFT_DUMMY_USER_NAME=test_user@example.com
# MICROSOFT_DUMMY_USER_PASSWORD=test_password


# OPTIONAL - Rate limiting overrides (defaults shown)
# RATE_LIMIT_GENERAL_MAX=120
# RATE_LIMIT_AUTH_MAX=20
# RATE_LIMIT_VOTE_MAX=30
# RATE_LIMIT_UPLOAD_MAX=10
# RATE_LIMIT_WINDOW_MS=60000


# OPTIONAL - Number of trusted reverse proxies in front of this app (0-10)
# Configure only when each proxy appends the actual peer address to X-Forwarded-For.
# TRUSTED_PROXY_HOPS=1

# OPTIONAL - Set to any truthy value to disable debug routes outside production (production disables them automatically)
# DISABLE_DEBUG_ROUTES=true
