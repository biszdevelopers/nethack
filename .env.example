# REQUIRED - basis-auth cookie encryption key, must be at least 32 bytes
# Generate with: openssl rand -base64 32 or node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BASIS_AUTH_COOKIE_SECRET=random_string_at_least_32_bytes_long

# REQUIRED - PostgreSQL connection used by development, CI, and production
# Keep credentials in a protected environment file; do not commit real values.
DATABASE_URL=postgresql://basishacks:replace_me@127.0.0.1:5432/basishacks

# OPTIONAL - Bounded PostgreSQL pool size (default 10; accepted range 2-64)
DATABASE_POOL_MAX=10

# Blank or local reads the checkout's HACKATHON.yml. Supply the assets server origin
# or full manifest URL to load remotely. Use database only during rollback.
# Remote manifests are backed up to assets/hackathon-config.yml automatically.
YAML_SOURCE_HACKATHON=local

# OPTIONAL - Remote manifest backup path (default shown)
# HACKATHON_CACHE_PATH=assets/hackathon-config.yml

# OPTIONAL - Local manifest read and (in local mode) rewritten by the mod portal
# HACKATHON_CONFIG_PATH=HACKATHON.yml

# OPTIONAL - Local basis-auth avatar cache (default: assets/basis-auth-pictures)
# BASIS_AUTH_PICTURE_CACHE_DIR=assets/basis-auth-pictures

# OPTIONAL - Emit bounded PostgreSQL query and pool wait timing summaries once per minute
# DATABASE_METRICS=1

# OPTIONAL - One-time SQLite migration source path; used only by the import command
# SQLITE_IMPORT_PATH=/secure/backups/basishacks.sqlite

# REQUIRED - basis-auth OpenID Connect configuration
BASIS_AUTH_ISSUER=http://localhost:3000
BASIS_AUTH_CLIENT_ID=your_basis_auth_client_id_here
BASIS_AUTH_CLIENT_SECRET=your_basis_auth_client_secret_here
BASIS_AUTH_RESOURCE=devconnect://nethack.bisz.dev

# REQUIRED - basis-auth resource credentials for backchannel logout
# The secret is issued once by basis-auth; rotate it in the portal and update
# every caller (this app and any other resource client) together.
BASIS_AUTH_RESOURCE_SECRET=your_basis_auth_resource_secret_here
# Private listener used for webhook verification and user-state checks.
# The receiver URL ${CURRENT_URL_ORIGIN}/api/auth/basis/backchannel must be
# registered and verified in basis-auth, otherwise sign-in fails with 14408.
BASIS_AUTH_INTERNAL_URL=http://127.0.0.1:3001


# OPTIONAL - Comma-separated allowlist of initial administrator emails.
# When unset or empty, the built-in fallback list keeps existing deployments
# working. Matching is case-insensitive; configured accounts are elevated when
# they sign in and may be demoted by another administrator afterwards.
# INITIAL_ADMIN_EMAILS=admin1@example.com,admin2@example.com


# REQUIRED in production; used to derive the callback URL and enforce same-origin mutations
# `${CURRENT_URL_ORIGIN}/api/auth/basis/callback` must be registered in basis-auth.
# Set this to the public HTTPS origin for the deployment, with no trailing path.
# Loopback HTTP origins are accepted only while bound to 127.0.0.1; the launcher
# sets that bind and the matching port by default.
# Local production (`bun run start`) uses http://localhost:3000.
# `bun dev --https` serves https://localhost:24598, so set that origin while developing.
CURRENT_URL_ORIGIN=http://localhost:3000

# OPTIONAL - Isolated E2E only; use a separate local PostgreSQL database and app origin.
# The browser harness never falls back to DATABASE_URL.
# BASISHACKS_E2E_DATABASE_URL=postgresql://e2e:replace_me@127.0.0.1:5432/basishacks_e2e
# PLAYWRIGHT_BASE_URL=http://127.0.0.1:24599

# OPTIONAL - DeepSeek API key for AI chat features (debug routes only)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OPTIONAL - Server port/host override (defaults: port=3000, host=0.0.0.0)
# PORT=3000
# HOST=0.0.0.0

# OPTIONAL - Rate limiting overrides (defaults shown)
# RATE_LIMIT_GENERAL_MAX=1200
# RATE_LIMIT_AUTH_MAX=200
# RATE_LIMIT_VOTE_MAX=300
# RATE_LIMIT_UPLOAD_MAX=100
# RATE_LIMIT_WINDOW_MS=60000


# OPTIONAL - Number of trusted reverse proxies in front of this app (0-10)
# WARNING: leave this unset only when clients connect directly. With exactly one
# nginx in front, set 1; otherwise every caller shares the proxy address and the
# per-IP rate limit becomes one global bucket. The app logs a startup warning
# when it is 0 in production.
# TRUSTED_PROXY_HOPS=1

# OPTIONAL - Include extra diagnostics in health responses (never database details)
# HEALTH_DETAILS=0

# OPTIONAL - Rate limiter sizes (defaults shown)
# RATE_LIMIT_REQUEST_GATE_MAX=6000
# RATE_LIMIT_BACKCHANNEL_MAX=600

# OPTIONAL - Profile update body-read deadline in milliseconds (default 30000)
# PROFILE_UPDATE_DEADLINE_MS=30000

# OPTIONAL - Enforce published event deadlines in addition to status switches (default on)
# ENFORCE_DEADLINES=1
# OPTIONAL - Submission grace period in milliseconds after end_timestamp (default 0)
# SUBMISSION_GRACE_MS=0
# OPTIONAL - Allow judging after results are published (default off)
# JUDGING_AFTER_PUBLISH=0
# OPTIONAL - Require a verified-email claim at login (default off)
# REQUIRE_VERIFIED_EMAIL=0
# OPTIONAL - Initial administrator bootstrap list (comma-separated)
# INITIAL_ADMIN_EMAILS=admin1@example.com,admin2@example.com
# OPTIONAL - Team invitation lifetime in days (default 7)
# TEAM_INVITE_TTL_DAYS=7
# OPTIONAL - HTTPS webhook for in-app notification copies (fire-and-forget)
# NOTIFICATION_WEBHOOK_URL=https://example.com/hooks/hackathon
# OPTIONAL - Slow-query log threshold in milliseconds when DATABASE_METRICS=1 (default 250)
# DATABASE_SLOW_QUERY_MS=250
# OPTIONAL - Profile update body-read deadline in milliseconds (0 disables; default 30000)
# PROFILE_UPDATE_DEADLINE_MS=30000

# OPTIONAL - Backup snapshot directory and retention (defaults shown)
# BACKUP_DIR=/srv/backups/basishacks
# BACKUP_RETENTION_DAYS=14
# Optional off-box copy performed by scripts/backup-postgres.mjs via rsync:
# BACKUP_RSYNC_TARGET=user@offsite.example:/srv/backups/basishacks

# OPTIONAL - Feature switches (defaults shown; all enabled unless set to 0)
# PUBLIC_GALLERY_MODE=1
# PEOPLES_CHOICE_ENABLED=1
# NOTIFICATIONS_ENABLED=1

# OPTIONAL - Set to any truthy value to disable debug routes outside production (production disables them automatically)
# DISABLE_DEBUG_ROUTES=true


# OPTIONAL - Tooling only; not read by the application at runtime
# VPS_RELEASE_OUTPUT_DIR=release-package
# VPS_RELEASE_INCLUDE_NODE_MODULES=1
# BENCHMARK_HEADERS_JSON={"cookie":"session=..."}
